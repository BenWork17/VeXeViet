{
  "extends": "../../packages/config/typescript/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@vexeviet/types": ["../../packages/types/src"],
      "@vexeviet/types/*": ["../../packages/types/src/*"],
      "@vexeviet/api-client": ["../../packages/api-client/src"],
      "@vexeviet/api-client/*": ["../../packages/api-client/src/*"],
      "@vexeviet/ui": ["../../packages/ui/src"],
      "@vexeviet/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "e2e"]
}
