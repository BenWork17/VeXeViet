{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "allowJs": false,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx"
  },
  "include": ["${configDir}/src/**/*.ts", "${configDir}/src/**/*.tsx"],
  "exclude": ["${configDir}/node_modules", "${configDir}/dist"]
}
